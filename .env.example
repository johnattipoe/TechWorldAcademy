# Copy this file to .env and fill in deployment-specific values.
# Keep Firebase and Cloudflare server credentials private and outside public/.

# Application
APP_NAME=TechWorld Academy
APP_ENV=local
APP_URL=http://127.0.0.1:8000
PUBLIC_WEBSITE_URL=http://127.0.0.1:8000
LEARNING_PLATFORM_URL=http://127.0.0.1:8001

# Firebase Admin / Firestore
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS=storage/keys/firebase-service-account.json

# Firebase browser app settings (optional; browser key is not a server secret)
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Cloudflare R2 (create an API token with object read/write permissions)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_PUBLIC_URL=

# Contact form throttling and email
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW=3600
CONTACT_EMAIL=you@example.com
# Resend HTTP API. Create a sending-only key and keep it server-side.
RESEND_API_KEY=
# Use an address on a domain verified by Resend, e.g. TechWorld Academy <no-reply@your-domain.com>.
MAIL_FROM=

# Generate with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
NEWSLETTER_UNSUBSCRIBE_SECRET=

# Paystack hosted checkout (keep the secret key private on the server)
PAYSTACK_SECRET_KEY=

# One-time initial admin account bootstrap; remove the hash after setup.
ADMIN_NAME=TechWorld Academy Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
